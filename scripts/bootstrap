#!/bin/bash
set -euo pipefail
umask 077
root="$(cd "$(dirname "$0")/.." && pwd)"
version="$(cat "$root/paperclip-version")"
node="${PAPERCLIP_NODE:-$(command -v node)}"
"$node" -e 'const [a,b]=process.versions.node.split(".").map(Number); if(a<24 || (a===24 && b<15)) { console.error("Paperclip requires Node >=24.15; see README.md"); process.exit(1); }'
export PAPERCLIP_HOME="${PAPERCLIP_HOME:-$HOME/.paperclip}"
export PAPERCLIP_INSTANCE_ID="${PAPERCLIP_INSTANCE_ID:-factory}"
export PATH="$(dirname "$node"):$HOME/.local/bin:$PATH"
export PAPERCLIP_TELEMETRY_DISABLED="${PAPERCLIP_TELEMETRY_DISABLED:-1}"
export npm_config_cache="${npm_config_cache:-$HOME/.cache/npm}"
# Mise's npm shim can pin a different Node; invoke npm's JS using the validated Node.
npx_cli="$(npm root -g)/npm/bin/npx-cli.js"
[[ -f "$npx_cli" ]] || { echo 'Cannot locate npm npx-cli.js' >&2; exit 1; }
mkdir -p "$PAPERCLIP_HOME"
chmod 700 "$PAPERCLIP_HOME"
available_kb="$(df -Pk "$PAPERCLIP_HOME" | awk 'NR==2 {print $4}')"
min_free_gib="${PAPERCLIP_MIN_FREE_GIB:-10}"
if [[ ! "$min_free_gib" =~ ^[1-9][0-9]?$ ]]; then
  echo 'PAPERCLIP_MIN_FREE_GIB must be an integer from 1 to 99.' >&2
  exit 1
fi
if (( available_kb < min_free_gib * 1024 * 1024 )); then
  echo "Allow at least $min_free_gib GiB free for installation and temporary files (conservative budget)." >&2
  exit 1
fi
cd "$PAPERCLIP_HOME"
case "${PAPERCLIP_INSTALL_METHOD:-managed}" in
  managed)
    "$node" "$npx_cli" --yes --registry=https://registry.npmjs.org "paperclipai@$version" install --version "$version" --yes
    ;;
  global)
    prefix="$HOME/.local/share/paperclip-global"
    launcher="$HOME/.local/share/paperclip-factory/bin/paperclipai"
    "$node" "$(dirname "$npx_cli")/npm-cli.js" install --global --prefix "$prefix" --registry=https://registry.npmjs.org "paperclipai@$version" --no-audit --no-fund
    mkdir -p "$(dirname "$launcher")"
    temporary="$launcher.$$.tmp"
    trap 'rm -f "$temporary"' EXIT
    {
      printf '#!/bin/bash\nset -euo pipefail\nexport PAPERCLIP_TELEMETRY_DISABLED=1\n'
      printf 'export PATH=%q:"$PATH"\n' "$(dirname "$node")"
      printf 'exec %q %q "$@"\n' "$node" "$prefix/lib/node_modules/paperclipai/dist/index.js"
    } > "$temporary"
    chmod 700 "$temporary"
    mv "$temporary" "$launcher"
    ;;
  *) echo 'PAPERCLIP_INSTALL_METHOD must be managed or global.' >&2; exit 1 ;;
esac
echo 'Installed. Next run scripts/paperclip onboard interactively.'
echo 'Decline service installation and immediate startup, then follow README.md to configure authentication.'
