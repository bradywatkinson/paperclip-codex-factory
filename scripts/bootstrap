#!/bin/bash
set -euo pipefail
umask 077
root="$(cd "$(dirname "$0")/.." && pwd)"
version="$(cat "$root/paperclip-version")"
node="$(command -v node)"
"$node" -e 'const [a,b]=process.versions.node.split(".").map(Number); if(a<24 || (a===24 && b<11)) { console.error("Paperclip requires Node >=24.11; see README.md"); process.exit(1); }'
export PAPERCLIP_HOME="${PAPERCLIP_HOME:-$HOME/.paperclip}"
export PAPERCLIP_INSTANCE_ID="${PAPERCLIP_INSTANCE_ID:-factory}"
export PATH="$(dirname "$node"):$HOME/.local/bin:$PATH"
export npm_config_cache="${npm_config_cache:-$HOME/.cache/npm}"
# Mise's npm shim can pin a different Node; invoke npm's JS using the validated Node.
npx_cli="$(npm root -g)/npm/bin/npx-cli.js"
[[ -f "$npx_cli" ]] || { echo 'Cannot locate npm npx-cli.js' >&2; exit 1; }
mkdir -p "$PAPERCLIP_HOME"
chmod 700 "$PAPERCLIP_HOME"
cd "$PAPERCLIP_HOME"
"$node" "$npx_cli" --yes --registry=https://registry.npmjs.org "paperclipai@$version" install --version "$version" --yes
config="$PAPERCLIP_HOME/instances/$PAPERCLIP_INSTANCE_ID/config.json"
if [[ ! -e "$config" ]]; then
  "$HOME/.local/bin/paperclipai" onboard --yes --no-install-service
fi
"$node" "$root/scripts/configure-local.mjs" "$config"
echo 'Configured. Review README.md, then start the foreground server with scripts/paperclip run.'
